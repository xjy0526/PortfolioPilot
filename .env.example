# PortfolioPilot Konfiguration
# Kopiere diese Datei als .env und trage deine Werte ein:
#   copy .env.example .env

# Branding
APP_NAME=PortfolioPilot
APP_TAGLINE=Multi-market portfolio risk analysis and evidence-driven research.
CONTACT_EMAIL=
# personal: full personal dashboard; fund_research: institution-oriented research UI
APP_MODE=personal
DISPLAY_TIMEZONE=Asia/Shanghai

# PostgreSQL + asyncpg. Start the local database with:
#   docker compose up -d postgres
DATABASE_URL=postgresql+asyncpg://portfoliopilot:portfoliopilot@localhost:5432/portfoliopilot
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DEFAULT_PORTFOLIO_ID=
MAX_TRANSACTION_IMPORT_BYTES=5242880
CODE_VERSION=unknown

# Market data. Tushare is used for A-share daily facts; yfinance is research-only.
TUSHARE_TOKEN=
MARKET_SYNC_LOOKBACK_DAYS=365
# Add tushare after configuring TUSHARE_TOKEN: tushare,yfinance
MARKET_DATA_PROVIDERS=yfinance

# Optional extensions. They are disabled unless explicitly enabled.
ENABLE_POLYMARKET=false
ENABLE_TELEGRAM=false
ENABLE_PARQET=false
ENABLE_SHADOW_AGENT=false
ENABLE_TECH_RADAR=false
ENABLE_TRADE_ADVISOR=false

# Old SQLite cache/JSON migration bridge. Keep false for the PostgreSQL mainline.
# Development/test may opt in for explicit compatibility checks. Production rejects true.
ENABLE_LEGACY_SQLITE_COMPAT=false

# Financial Modeling Prep API Key (kostenlos: https://financialmodelingprep.com)
FMP_API_KEY=your_fmp_api_key_here

# Optional Parqet Connect API (requires ENABLE_PARQET=true)
# Registriere eine App auf https://developer.parqet.com
PARQET_CLIENT_ID=your_parqet_client_id
PARQET_CLIENT_SECRET=your_parqet_client_secret
PARQET_ACCESS_TOKEN=
PARQET_REFRESH_TOKEN=
PARQET_PORTFOLIO_ID=your_portfolio_id

# Parqet CSV Export Pfad (Fallback, relativ zum Projektverzeichnis)
PARQET_PORTFOLIO_CSV=portfolio.csv

# Server Konfiguration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=development
READ_ONLY_DEMO=false
ALLOW_RUNTIME_SECRET_CONFIGURATION=false
ALLOW_DEV_IDENTITY_HEADERS=false

# AI Provider
AI_PROVIDER=qwen
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# Optional generic OpenAI-compatible endpoint (set AI_PROVIDER=openai_compatible)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4.1-mini
QWEN_REASONING_MODEL=

# Optional Telegram Bot (requires ENABLE_TELEGRAM=true).
# 1) Erstelle Bot via @BotFather auf Telegram → /newbot
# 2) Chat-ID: Sende dem Bot eine Nachricht, dann https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# AI Finance Agent - tägliche Report-Zeit
AI_AGENT_TIME=16:30

# PostgreSQL RAG plus legacy local-directory compatibility tools.
# Core APIs use pgvector; RAG_DOCUMENT_DIR is only for explicit legacy tools.
RAG_DOCUMENT_DIR=rag_documents
EMBEDDING_PROVIDER=sentence_transformers
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_ALLOW_HASHING_FALLBACK=true
RAG_CHUNK_SIZE=900
RAG_TOP_K=5
RAG_VECTOR_BACKEND=pgvector
RAG_SCORE_THRESHOLD=0.15
RAG_VECTOR_SCORE_THRESHOLD=0.20
RAG_RRF_K=60
RAG_RETRIEVAL_POOL_SIZE=20
RAG_EMBEDDING_DIMENSION=384
RAG_RERANKER_ENABLED=false
RAG_MAX_UPLOAD_BYTES=10485760
RAG_MAX_PDF_PAGES=200
RAG_MAX_CHUNKS=5000
RAG_PARSE_TIMEOUT_SECONDS=60
RAG_INGESTION_DIR=data/ingestion
RAG_SUCCESS_SOURCE_RETENTION_DAYS=0
RAG_FAILURE_SOURCE_RETENTION_DAYS=7

# Shared source-object storage. Local is only for development/test or read-only demo.
# Production write mode requires S3-compatible storage shared by every process.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_ROOT=data/object_storage
# Canonical S3 configuration. S3_ENDPOINT_URL may be empty only for AWS S3.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=research-ingestion
S3_FORCE_PATH_STYLE=false
# Deprecated aliases accepted during migration; prefer the S3_* names above.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PREFIX=research-ingestion
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Durable Workflow worker lease and retry policy.
WORKFLOW_LEASE_SECONDS=60
WORKFLOW_MAX_ATTEMPTS=5
WORKFLOW_RETRY_BASE_SECONDS=2

LOCAL_PRINCIPAL_USER=local-user
LOCAL_PRINCIPAL_TENANT=default
LOCAL_PRINCIPAL_ROLES=platform_admin,operator,market_data_admin,knowledge_admin,research_reviewer
LOCAL_PRINCIPAL_GROUPS=public

# Optional historical prices CSV for strategy backtest.
# Supported formats: wide date,AAPL,MSFT or long date,ticker,close.
BACKTEST_PRICE_CSV=data/prices/example_historical_prices.csv

# Historical adjusted-close data used by the portfolio risk APIs.
PRICE_HISTORY_PROVIDER=yfinance
PRICE_HISTORY_CSV=
PRICE_HISTORY_LOOKBACK_DAYS=365
PRICE_HISTORY_STALE_AFTER_DAYS=5
RISK_MIN_OBSERVATIONS=20

# Dashboard-Passwortschutz (Basic Auth)
# Wenn leer → kein Passwortschutz (z.B. lokal)
DASHBOARD_USER=
DASHBOARD_PASSWORD=
DASHBOARD_TENANT_ID=default
DASHBOARD_ROLES=platform_admin
DASHBOARD_PERMISSION_GROUPS=public

# Telegram Webhook Secret (zufälliges Token)
# Generieren: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
